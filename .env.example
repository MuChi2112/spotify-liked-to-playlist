# 到 https://developer.spotify.com/dashboard 建立一個 App 後填入以下三個值
# Redirect URI 要跟你在 Dashboard 設定的完全一致（含結尾斜線與否都要一致）
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# 要新建立的歌單名稱（可省略，預設 "Liked Songs Playlist"）
PLAYLIST_NAME=我的按讚歌曲
# 歌單描述（可省略）
PLAYLIST_DESCRIPTION=由程式自動從按讚歌曲建立
# 歌單是否公開，true/false（可省略，預設 false）
PLAYLIST_PUBLIC=false
